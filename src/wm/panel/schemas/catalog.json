  {
    "id": "wm.quest.release.story_arc.v1",
    "label": "Story Arc",
    "description": "A linked set of one-shot quest nodes plus journey metadata.",
    "lane": "quest",
    "mutating": true,
    "dry_run_required": true,
    "validator": "wm.content.release",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "quest_kind", "player_guid", "arc_key", "nodes", "edges"],
      "properties": {
        "schema_version": { "type": "string", "const": "wm.quest.release.story_arc.v1", "default": "wm.quest.release.story_arc.v1" },
        "quest_kind": { "type": "string", "const": "story_arc", "default": "story_arc" },
        "player_guid": { "type": "integer", "default": 5406 },
        "arc_key": { "type": "string", "minLength": 1 },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["node_key", "quest_schema", "fresh_reserved_required"],
            "properties": {
              "node_key": { "type": "string" },
              "quest_id": { "type": ["integer", "null"], "default": null },
              "quest_schema": { "type": "string", "default": "wm.quest.release.one_shot.v1" },
              "fresh_reserved_required": { "type": "boolean", "default": true },
              "title": { "type": ["string", "null"], "default": null }
            }
          }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "kind"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "kind": { "type": "string", "enum": ["turn_in_unlocks", "reward_next_quest", "prev_next_link", "breadcrumb", "branch_unlocks"], "ui:enumNames": ["Turn-in unlocks", "Reward next quest", "Prev/next link", "Breadcrumb", "Branch unlocks"] }
            }
          }
        },
        "fork_groups": { "type": "array", "items": { "type": "object" }, "default": [] },
        "journey_updates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stage_key": { "type": ["string", "null"], "default": null },
            "branch_key": { "type": ["string", "null"], "default": null },
            "conversation_steering": { "type": "array", "items": { "type": "object" }, "default": [] },
            "prompt_queue": { "type": "array", "items": { "type": "object" }, "default": [] },
            "reward_instance": { "type": "object", "additionalProperties": true, "default": {} }
          },
          "default": {}
        },
        "runtime_sync": { "type": "object", "additionalProperties": true, "default": { "mode": "manual" } },
        "notes": { "type": ["array", "string", "null"], "items": { "type": "string" }, "default": [] }
      }
    },
