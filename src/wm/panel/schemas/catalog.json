  {
    "id": "wm.quest.release.repeatable_bounty.v1",
    "label": "Repeatable Bounty",
    "description": "A repeatable kill bounty released through WM content gates.",
    "lane": "quest",
    "mutating": true,
    "dry_run_required": true,
    "validator": "wm.content.release",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "quest_kind", "player_guid", "slot_policy", "repeatable", "quest", "objective", "reward"],
      "properties": {
        "schema_version": { "type": "string", "const": "wm.quest.release.repeatable_bounty.v1", "default": "wm.quest.release.repeatable_bounty.v1" },
        "quest_kind": { "type": "string", "const": "repeatable_bounty", "default": "repeatable_bounty" },
        "player_guid": { "type": "integer", "default": 5406 },
        "slot_policy": {
          "type": "string",
          "enum": ["fresh_reserved_or_existing_active_repeatable", "fresh_reserved_required"],
          "default": "fresh_reserved_or_existing_active_repeatable"
        },
        "repeatable": { "type": "boolean", "const": true, "default": true },
        "quest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quest_level", "min_level", "grant_mode", "template_defaults"],
          "properties": {
            "quest_id": { "type": ["integer", "null"], "default": null, "minimum": 1, "maximum": 999999 },
            "quest_level": { "type": "integer", "default": 70, "minimum": 1 },
            "min_level": { "type": "integer", "default": 68, "minimum": 1 },
            "questgiver_entry": { "type": ["integer", "null"], "default": null, "minimum": 1, "maximum": 999999 },
            "questgiver_name": { "type": ["string", "null"], "default": null },
            "title": { "type": ["string", "null"], "default": null },
            "quest_description": { "type": ["string", "null"], "ui:widget": "textarea", "default": null },
            "objective_text": { "type": ["string", "null"], "default": null },
            "offer_reward_text": { "type": ["string", "null"], "ui:widget": "textarea", "default": null },
            "request_items_text": { "type": ["string", "null"], "ui:widget": "textarea", "default": null },
            "grant_mode": { "type": "string", "enum": ["npc_start", "direct_grant", "manual_operator"], "ui:enumNames": ["NPC start", "Direct grant", "Manual operator"], "default": "npc_start" },
            "start_npc_entry": { "type": ["integer", "null"], "default": null, "minimum": 1, "maximum": 999999 },
            "end_npc_entry": { "type": ["integer", "null"], "default": null, "minimum": 1, "maximum": 999999 },
            "template_defaults": {
              "type": "object",
              "additionalProperties": true,
              "required": ["SpecialFlags"],
              "properties": {
                "SpecialFlags": { "type": "integer", "const": 1, "default": 1 },
                "PrevQuestID": { "type": ["integer", "null"], "default": null },
                "NextQuestID": { "type": ["integer", "null"], "default": null },
                "RewardNextQuest": { "type": ["integer", "null"], "default": null },
                "ExclusiveGroup": { "type": ["integer", "null"], "default": null },
                "BreadcrumbForQuestId": { "type": ["integer", "null"], "default": null }
              },
              "default": { "SpecialFlags": 1 }
            }
          }
        },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target_entry", "kill_count"],
          "properties": {
            "kind": { "type": "string", "const": "kill", "default": "kill" },
            "target_entry": { "type": "integer", "minimum": 1, "maximum": 999999 },
            "target_name": { "type": ["string", "null"], "default": null },
            "kill_count": { "type": "integer", "default": 6 }
          }
        },
        "reward": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "type": "string", "enum": ["none", "money", "item", "spell"], "ui:enumNames": ["No reward", "Money", "Item", "Spell"], "default": "item" },
            "money_copper": { "type": ["integer", "null"], "default": null },
            "item_entry": { "type": ["integer", "null"], "default": null, "minimum": 1, "maximum": 999999 },
            "item_name": { "type": ["string", "null"], "default": null },
            "item_count": { "type": ["integer", "null"], "default": 1 },
            "spell_id": { "type": ["integer", "null"], "default": null, "minimum": 1, "maximum": 999999 },
            "spell_display_id": { "type": ["integer", "null"], "default": null, "minimum": 1, "maximum": 999999 },
            "fresh_visible_reward_ids_required": { "type": "boolean", "default": true }
          }
        },
        "runtime_sync": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["auto", "manual", "none"], "ui:enumNames": ["Automatic", "Manual", "None"], "default": "auto" },
            "notes": { "type": ["string", "null"], "ui:widget": "textarea", "default": null }
          },
          "default": { "mode": "auto" }
        },
        "notes": { "type": ["array", "string", "null"], "items": { "type": "string" }, "default": [] }
      }
    },
    "ui": {
      "order": ["schema_version", "quest_kind", "player_guid", "slot_policy", "repeatable", "quest", "objective", "reward", "runtime_sync", "notes"],
      "icon": "quest"
    }
  },
