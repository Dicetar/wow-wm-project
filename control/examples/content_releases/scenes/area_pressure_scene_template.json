      "requires_live_proof": true
    },
    {
      "step_key": "announce",
      "native_action_kind": "world_announce_to_player",
      "payload": {
        "message": "WM pressure spike: hold the line."
      },
      "risk_level": "low",
      "idempotency_suffix": "announce",
