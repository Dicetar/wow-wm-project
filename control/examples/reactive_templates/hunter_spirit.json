{
  "schema": "wm.reactive_template.v1",
  "id": "hunter_spirit",
  "narrative_hook": "Beasts have fallen by your hand. A spirit-form rises from the kill in <zone>.",
  "trigger": {
    "event": "kill",
    "params": {"creature_family": "<slot>", "zone": "<slot>", "count": {"min": 5, "window_min": 10}},
    "scope": "active_character",
    "cooldown_min": 90,
    "dedupe_key": "hunter_spirit:{zone}:{creature_family}"
  },
  "recipe": {
    "kind": "quest",
    "compiler": "wm.content.release/repeatable_bounty",
    "slots": {"creature_family": "trigger.creature_family", "zone": "trigger.zone",
              "title": "<llm-filled>", "description": "<llm-filled>", "reward_theme": "<llm-filled>"}
  },
  "guards": {"feasibility_tier": "T1", "max_concurrent": 1,
             "idempotency_key_template": "watch:hunter_spirit:{character_guid}:{zone}:{creature_family}"}
}
