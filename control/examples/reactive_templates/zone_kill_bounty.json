{
  "schema": "wm.reactive_template.v1",
  "id": "zone_kill_bounty",
  "narrative_hook": "WM notices you've been thinning the <creature_family> in <zone>.",
  "trigger": {
    "event": "kill",
    "params": {"creature_family": "<slot>", "zone": "<slot>", "count": {"min": 8, "window_min": 15}},
    "scope": "active_character",
    "cooldown_min": 60,
    "dedupe_key": "zone_kill_bounty:{zone}:{creature_family}"
  },
  "recipe": {
    "kind": "quest",
    "compiler": "wm.content.release/repeatable_bounty",
    "slots": {"creature_family": "trigger.creature_family", "zone": "trigger.zone",
              "reward_theme": "<llm-filled>", "title": "<llm-filled>", "description": "<llm-filled>"}
  },
  "guards": {"feasibility_tier": "T1", "max_concurrent": 1,
             "idempotency_key_template": "watch:zone_kill_bounty:{character_guid}:{zone}:{creature_family}"}
}
