[worldserver]

#
# WM native bridge
# Thin native sensor module. Emits raw server-truth rows into wm_bridge_event.
#

#
#    WmBridge.Enable
#        Master switch for the native bridge module.
#
#        Default: 1
#
WmBridge.Enable = 1

#
#    WmBridge.PlayerGuidAllowList
#        Comma-separated low player GUIDs that WM may observe.
#        Empty means disabled for every player. Use "*" only for short debug runs,
#        because it allows full-server bridge emission.
#
#        Examples:
#            WmBridge.PlayerGuidAllowList = "5406"
#            WmBridge.PlayerGuidAllowList = "5406,8123"
#
#        Default: ""
#
WmBridge.PlayerGuidAllowList = ""

WmBridge.Emit.Kill = 1
WmBridge.Emit.Quest = 1
WmBridge.Emit.Loot = 0
WmBridge.Emit.Gossip = 1
WmBridge.Emit.Area = 1

#
#    WmBridge.Emit.LevelUp / WmBridge.Emit.Death
#        Emit progress/level_up and combat/death events for scoped players so
#        WM can react to those moments (ambient narration, arcs). Server-truth
#        only; no client changes.
#
#        Default: 1
#
WmBridge.Emit.LevelUp = 1
WmBridge.Emit.Death = 1

#
#    WmBridge.Emit.Aura
#        Emit player aura apply/remove events for the configured marker spells.
#        Keep this scoped through PlayerGuidAllowList / wm_bridge_player_scope.
#
#        Default: 0
#
WmBridge.Emit.Aura = 0

#
#    WmBridge.Emit.AuraSpellAllowList
#        Comma-separated spell IDs that may emit aura events when aura emission
#        is enabled. Use "*" only for short debug runs.
#
#        Defaults cover current visible WM markers:
#        - 946602: WM Watcher Beacon player discovery marker
#        - 132: legacy Detect Invisibility / watcher-lens marker fallback
#        - 687: area-pressure scene marker
#        - 770: Lens target mark
#
WmBridge.Emit.AuraSpellAllowList = "946602,132,687,770"

#
#    WmBridge.AoeLoot.Enable
#        When enabled for an allowed WM player, looting one corpse also gathers
#        lootable nearby corpses already tapped by that player/group. This is a
#        server-side 3.3.5 QoL path, not a client AoE-loot packet.
#
#        Default: 0
#
WmBridge.AoeLoot.Enable = 0
WmBridge.AoeLoot.Radius = 35
WmBridge.AoeLoot.MaxCorpses = 25

#
#    WmBridge.DbControl.Enable
#        When enabled, the bridge also reads wm_bridge_player_scope every
#        WmBridge.DbControl.RefreshIntervalMS. This lets WM enable or disable
#        a player live from DB without editing this file.
#
#        Default: 0
#
WmBridge.DbControl.Enable = 0
WmBridge.DbControl.RefreshIntervalMS = 5000

#
#    WmBridge.ActionQueue.Enable
#        Poll wm_bridge_action_request and execute registered native actions.
#        Keep disabled until the lab DB has wm_bridge_* action tables and a
#        single player is scoped in wm_bridge_player_scope.
#
#        Default: 0
#
WmBridge.ActionQueue.Enable = 0
WmBridge.ActionQueue.PollIntervalMS = 1000

#
#    WmBridge.Presence.Enable
#        Heartbeat live player location/state into wm_bridge_player_presence
#        for scoped players. Gives WM an always-fresh map/zone/area + coords
#        + level/health/combat row per player, replacing the stale
#        characters-table position for online players.
#
#        Default: 1
#
WmBridge.Presence.Enable = 1
WmBridge.Presence.IntervalMS = 3000

#
#    WmBridge.Perception.Enable
#        Heartbeat the nearby creatures/gameobjects around each scoped player
#        into wm_bridge_player_perception, so WM is continuously aware of the
#        player's surroundings (same payload as context_snapshot_request, but
#        ambient and upserted per player rather than on demand). Heavier than
#        presence (a radius scan per player), so it runs on a slower timer.
#
#        The interval is deliberately long: WM only needs cheap ambient
#        awareness (entity counts) on this timer, and pulls full detail on
#        demand via context_snapshot_request when it decides to look closer.
#        A fast perception timer would flood a small local model with new
#        surroundings data every turn.
#
#        Default: 1
#
WmBridge.Perception.Enable = 1
WmBridge.Perception.IntervalMS = 150000
WmBridge.Perception.Radius = 40
